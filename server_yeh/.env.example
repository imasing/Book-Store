# Copy thành .env rồi điền giá trị thật
PORT=8888
HOST=127.0.0.1
URI=mongodb://127.0.0.1:27017
DBNAME=bookstore
# Bắt buộc ở production; dev thiếu thì server tự sinh secret tạm (token mất hiệu lực khi restart)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Nhiều origin cách nhau bởi dấu phẩy
CORS_ORIGIN=http://localhost:3000
